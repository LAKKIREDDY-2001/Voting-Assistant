rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- Validation Helpers ---

    function isValidSession(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp &&
             (data.get('lastMessage', '') is string && data.get('lastMessage', '').size() <= 500) &&
             data.keys().hasAll(['userId', 'createdAt', 'updatedAt']) &&
             data.keys().size() <= 4;
    }

    function isValidMessage(data) {
      return data.role in ['user', 'model'] &&
             data.content is string &&
             data.content.size() <= 5000 &&
             data.timestamp is timestamp &&
             data.keys().hasAll(['role', 'content', 'timestamp']) &&
             data.keys().size() == 3;
    }

    // --- Rules ---

    match /sessions/{sessionId} {
      allow get: if isOwner(existing().userId);
      allow list: if isOwner(resource.data.userId);
      
      allow create: if isSignedIn() && 
                      isValidId(sessionId) && 
                      isValidSession(incoming()) && 
                      incoming().createdAt == request.time &&
                      incoming().updatedAt == request.time;
      
      allow update: if isOwner(existing().userId) &&
                      isValidSession(incoming()) &&
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().updatedAt == request.time &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt', 'lastMessage']);
      
      allow delete: if isOwner(existing().userId);

      match /messages/{messageId} {
        // Inherit path validation from session
        allow read: if isOwner(get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId);
        
        allow create: if isOwner(get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId) &&
                        isValidId(messageId) &&
                        isValidMessage(incoming()) &&
                        incoming().timestamp == request.time;
      }
    }
  }
}
